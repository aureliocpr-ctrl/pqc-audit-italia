{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pqc-audit-viewer",
  "version": "0.1.0",
  "identifier": "com.aureliocpr.pqcaudit.dashboard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "pqc-audit viewer",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "pqc-audit-italia desktop viewer",
    "longDescription": "Cross-OS read-only viewer for pqc-audit-italia JSON reports."
  }
}
